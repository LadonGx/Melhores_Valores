datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

model Product {
  id        String         @id @default(uuid())
  url       String         @unique
  name      String?
  imageUrl  String?
  store     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  history   PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float?
  inStock   Boolean  @default(true)
  scrapedAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model AutomaticSearchResult {
  id         String   @id @default(uuid())
  query      String
  store      String
  productUrl String
  productName String?
  price      Float?
  imageUrl   String?
  position   Int?
  searchedAt DateTime @default(now())

  @@index([query, store, searchedAt])
  @@index([store, searchedAt])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

model Product {
  id        String             @id @default(uuid())
  url       String             @unique
  name      String?
  imageUrl  String?
  store     String
  status    String             @default("active")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  history   PriceHistory[]
  groups    ProductGroupItem[]
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float?
  inStock   Boolean  @default(true)
  scrapedAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId, scrapedAt])
}

model SearchResult {
  id           String   @id @default(uuid())
  search_id    String
  query        String
  store        String
  title        String
  price        Float?
  currency     String   @default("BRL")
  image_url    String?
  product_url  String
  rating       Float?
  review_count Int?
  found_at     DateTime @default(now())

  @@index([search_id])
  @@index([query, store])
}

// Grupos de anúncios do mesmo produto em lojas diferentes (antes ficavam no
// localStorage do navegador e não apareciam em outro aparelho/endereço).
model ProductGroup {
  id        String             @id @default(uuid())
  name      String
  createdAt DateTime           @default(now())
  items     ProductGroupItem[]
}

model ProductGroupItem {
  groupId   String
  productId String
  group     ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([groupId, productId])
  @@index([productId])
}

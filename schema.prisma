datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "sync"
  recursive_type_depth = 5
}

model Product {
  id        String         @id @default(uuid())
  url       String         @unique
  name      String?
  imageUrl  String? // NOVO: Para mostrar a foto no front-end
  store     String // ex: 'amazon', 'mercadolivre', 'aliexpress'
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  history   PriceHistory[]
}

model PriceHistory {
  id        String   @id @default(uuid())
  price     Float? // Mudamos para opcional (Float?), pois se estiver sem estoque, não tem preço.
  inStock   Boolean  @default(true) // NOVO: O produto está disponível para compra?
  scrapedAt DateTime @default(now())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model SearchResult {
  id           String   @id @default(uuid())
  search_id    String
  query        String
  store        String
  title        String
  price        Float?
  currency     String   @default("BRL")
  image_url    String?
  product_url  String
  rating       Float?
  review_count Int?
  found_at     DateTime @default(now())

  @@index([search_id])
  @@index([query, store])
}

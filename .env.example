# Banco de dados: SQLite local, criado automaticamente na pasta de dados do usuário
# (Windows: %LOCALAPPDATA%\MelhoresValores\melhores_valores.db).
# Descomente para usar outra pasta (ex: em dev, para não misturar com o app instalado):
# MV_DATA_DIR="./.data"

# Configurações de Cache e Mensageria (Docker Default)
REDIS_URL="redis://localhost:6379/0"

# Credenciais Externas (opcional: sem chave, o nível 3 da cascata é ignorado)
FIRECRAWL_API_KEY=""
